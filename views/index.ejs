<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Your Love Page</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="container">
    <h1>💝 Create Your Love Page</h1>

    <% if (error) { %>
        <div class="alert error"><%= error %></div>
    <% } %>

    <% if (success) { %>
        <div class="alert success"><%= success %></div>
    <% } %>

    <form action="/create" method="POST" enctype="multipart/form-data" onsubmit="return validateForm()">

        <!-- TITLE -->
        <div class="form-group">
            <label>Page Title *</label>
            <input type="text" name="title" placeholder="For My Love..." required>
        </div>

        <!-- MESSAGE -->
        <div class="form-group">
            <label>Your Message *</label>
            <textarea name="message" placeholder="Write your heartfelt message..." required></textarea>
        </div>

        <!-- SLUG -->
        <div class="form-group">
            <label>Custom URL *</label>
            <input type="text" name="slug" placeholder="my-love-2024" required>
            <small>Your page: /p/<b>my-love-2024</b></small>
        </div>

        <!-- IMAGE -->
        <div class="form-group">
            <label>Upload Image (Optional)</label>
            <input type="file" name="image" accept="image/*">
        </div>

        <!-- MUSIC -->
        <div class="form-group">
            <label>Music URL</label>
            <input type="url" name="music_url" placeholder="https://youtube.com/...">
        </div>

        <!-- THEME -->
        <div class="form-group">
            <label>Choose Theme</label>
            <select name="theme">
                <option value="default">Romantic Pink</option>
                <option value="sunset">Sunset Orange</option>
                <option value="ocean">Ocean Blue</option>
                <option value="forest">Forest Green</option>
                <option value="midnight">Midnight Purple</option>
            </select>
        </div>

        <button type="submit" class="btn-create">✨ Create Page</button>
    </form>
</div>

<!-- SLUG AUTO GENERATOR -->
<script>
const titleInput = document.querySelector('input[name="title"]');
const slugInput = document.querySelector('input[name="slug"]');

titleInput.addEventListener('input', () => {
    const slug = titleInput.value
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');

    slugInput.value = slug;
});
</script>

<!-- FRONTEND VALIDATION -->
<script>
function validateForm() {
    const title = document.querySelector('input[name="title"]').value.trim();
    const message = document.querySelector('textarea[name="message"]').value.trim();
    const slug = document.querySelector('input[name="slug"]').value.trim();

    if (!title || !message || !slug) {
        alert("Please fill all required fields!");
        return false;
    }

    return true;
}
</script>

</body>
</html>
