<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Your Love Page</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1>💝 Create Your Love Page</h1>
        
        <% if (error) { %>
            <div class="alert error"><%= error %></div>
        <% } %>
        
        <form action="/create" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label>Page Title *</label>
                <input type="text" name="title" required placeholder="For My Love...">
            </div>
            
            <div class="form-group">
                <label>Your Message *</label>
                <textarea name="message" required 
                    placeholder="Write your heartfelt message here..."></textarea>
            </div>
            
            <div class="form-group">
                <label>Custom URL *</label>
                <input type="text" name="slug" required 
                    placeholder="my-love-2024">
                <small>Your page will be at: lovepage.onrender.com/p/<b>my-love-2024</b></small>
            </div>
            
            <div class="form-group">
                <label>Music URL (YouTube/SoundCloud)</label>
                <input type="url" name="music_url" 
                    placeholder="https://youtube.com/watch?v=...">
            </div>
            
            <div class="form-group">
                <label>Choose Theme</label>
                <select name="theme">
                    <option value="default">Romantic Pink</option>
                    <option value="sunset">Sunset Orange</option>
                    <option value="ocean">Ocean Blue</option>
                    <option value="forest">Forest Green</option>
                    <option value="midnight">Midnight Purple</option>
                </select>
            </div>
            
            <button type="submit" class="btn-create">✨ Create Page</button>
        </form>
    </div>
</body>
</html>
